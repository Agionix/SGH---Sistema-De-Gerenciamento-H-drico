# ==============================================================================
# SGH — SISTEMA DE GERENCIAMENTO HIDRÁULICO
# Configurações do Ambiente (Arquivo de Exemplo)
# ==============================================================================

# Porta do Servidor HTTP
PORT=3000
NODE_ENV=development

# Segredo da Sessão / Criptografia
SESSION_SECRET="sgh_super_secreto_chave_criptografica_offline_2026"

# Credenciais Iniciais do Administrador (criado automaticamente no primeiro boot)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Chave Mestra de Recuperação de Conta (usada para redefinir senhas offline com segurança)
MASTER_RECOVERY_KEY="SGH-RECOVERY-2026"

# Configuração da Porta Serial do ESP32
# Exemplos: Windows -> COM3, COM4 | Linux -> /dev/ttyUSB0, /dev/ttyACM0 | macOS -> /dev/cu.usbserial-0001
SERIAL_PORT="COM3"
SERIAL_BAUDRATE=115200
SERIAL_AUTO_CONNECT="true"

# Caminho do Banco de Dados SQLite Local
DB_PATH="./data/sgh.sqlite3"


# Parâmetros Padrão de Calibração e Tarifação
DEFAULT_TARIFF_M3=4.50
DEFAULT_CALIBRATION_FACTOR=7.5
DEFAULT_MAX_FLOW_LMIN=30.0
DEFAULT_CONTINUOUS_FLOW_LIMIT_MIN=45
DEFAULT_POLLING_INTERVAL_MS=1500
